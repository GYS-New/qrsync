{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install openpyxl qrcode pillow && npm run build"
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "cronJobs": [
      {
        "name": "gece-dongu",
        "schedule": "5 21 * * *",
        "command": "curl -s -H 'x-cron-secret: $CRON_SECRET' $RAILWAY_PUBLIC_DOMAIN/api/cron/gece-dongu?secret=$CRON_SECRET"
      },
      {
        "name": "mesai-arsiv",
        "schedule": "59 20 * * *",
        "command": "curl -s -H 'x-cron-secret: $CRON_SECRET' $RAILWAY_PUBLIC_DOMAIN/api/cron/mesai-arsiv"
      },
      {
        "name": "oto-yikama-arsiv",
        "schedule": "30 21 * * *",
        "command": "curl -s -H 'x-cron-secret: $CRON_SECRET' $RAILWAY_PUBLIC_DOMAIN/api/cron/oto-yikama-arsiv?secret=$CRON_SECRET"
      },
      {
        "name": "oto-yikama-hazir-acik",
        "schedule": "1 21 * * *",
        "command": "curl -s -H 'x-cron-secret: $CRON_SECRET' $RAILWAY_PUBLIC_DOMAIN/api/cron/oto-yikama-hazir-acik?secret=$CRON_SECRET"
      }
    ]
  }
}
